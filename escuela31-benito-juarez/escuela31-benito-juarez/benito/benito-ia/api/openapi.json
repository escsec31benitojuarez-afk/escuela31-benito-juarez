{
  "openapi": "3.1.0",
  "info": {
    "title": "Benito IA Provider Contract",
    "version": "1.0.0",
    "description": "Contrato independiente del proveedor para generar respuestas fundamentadas."
  },
  "paths": {
    "/v1/respond": {
      "post": {
        "summary": "Genera una respuesta institucional",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BenitoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta generada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenitoResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BenitoRequest": {
        "type": "object",
        "required": [
          "query",
          "context",
          "policy"
        ],
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500
          },
          "context": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "chunkId",
                "text",
                "source",
                "validated"
              ],
              "properties": {
                "chunkId": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "validated": {
                  "type": "boolean"
                }
              }
            }
          },
          "profile": {
            "type": [
              "string",
              "null"
            ]
          },
          "policy": {
            "type": "object",
            "required": [
              "mustGround",
              "mustCite",
              "allowPersonalData"
            ],
            "properties": {
              "mustGround": {
                "const": true
              },
              "mustCite": {
                "const": true
              },
              "allowPersonalData": {
                "const": false
              }
            }
          }
        }
      },
      "BenitoResponse": {
        "type": "object",
        "required": [
          "answer",
          "citations",
          "confidence",
          "provider"
        ],
        "properties": {
          "answer": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "provider": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}