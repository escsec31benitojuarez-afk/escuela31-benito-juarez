{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benito IA Knowledge Base",
  "type": "object",
  "required": [
    "meta",
    "entities"
  ],
  "properties": {
    "meta": {
      "type": "object"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "module",
          "title",
          "summary",
          "keywords",
          "validation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validation": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pendiente",
                  "validado",
                  "observado"
                ]
              }
            }
          }
        }
      }
    }
  }
}